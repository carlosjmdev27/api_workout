# Variables for docker compose (copy to .env in this folder; .env is never committed).

# Signs the session tokens (JWT). At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs every user out.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# true: anyone who reaches the app can create an account.
# Set to false once your account exists, then run: docker compose up -d
ALLOW_REGISTRATION=true

# Host port of the web (default 8080)
# WEB_PORT=8080

# Email confirmation (optional). Without RESEND_API_KEY the confirmation links appear in:
#   docker compose logs backend
# The key is a SECRET: keep it only in this .env (never committed).
# RESEND_API_KEY=
# EMAIL_FROM=AuraWorkout <onboarding@resend.dev>
