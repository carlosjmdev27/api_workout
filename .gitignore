# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Environment variables / secrets (keep ONLY the .example files, with fake values)
.env
.env.*
.env.local
!.env.example

# Databases: never commit real data, anywhere in the repo (incl. backups like gym-backup.sqlite)
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-journal
*.db-wal
*.db-shm
data/
server/database/*
!server/database/.gitkeep

# Local-only documentation (never pushed)
INSTRUCCIONESDEEJECUCION.md

# Logs
logs/
*.log
npm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

