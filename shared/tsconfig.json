{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // Incremental: `tsc --watch` skips re-emitting unchanged files on startup, so the
    // API (tsx watch) is not restarted a few seconds after `npm run dev`.
    "incremental": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",

    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
