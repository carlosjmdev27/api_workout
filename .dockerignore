# Build context = repo root (npm workspaces: server and client need shared/ and the root lockfile).
# Only sources and manifests go in; the images install and build everything themselves.

# Dependencies and build output (rebuilt inside the image)
**/node_modules
**/dist
**/build
**/*.tsbuildinfo

# Secrets and local config: never baked into an image (configuration comes from
# environment variables: Railway dashboard / docker-compose)
**/.env
**/.env.*

# Local databases: data lives in a volume (/app/data on Railway), never in the image
server/database
**/data
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.db
**/*.db-*

# Repo, editor and docs
.git
.gitignore
.gitattributes
.vscode
.idea
.claude
**/*.md
**/*.log
**/.DS_Store
**/Thumbs.db
coverage

# Docker files themselves
**/Dockerfile
**/.dockerignore
docker-compose.yml
