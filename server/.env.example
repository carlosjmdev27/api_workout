# Runtime environment: development | production | test
NODE_ENV=development

# Port where the API listens (default 3000; Railway injects its own)
PORT=3000

# Interface to listen on (default 0.0.0.0 = reachable from outside a container)
# HOST=0.0.0.0

# Exact frontend origin allowed by CORS (no trailing slash).
# Only when the web runs on another origin (Vite dev). Leave it unset in production.
CORS_ORIGIN=http://localhost:5173

# SQLite database file (relative to the /server folder; default ./data/database.sqlite).
# Railway: /app/data/database.sqlite (inside the volume mounted at /app/data)
DATABASE_PATH=./database/gym.sqlite

# Secret that signs the session tokens (JWT). At least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs every user out.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# true: anyone can create an account. Set to false once your account exists.
ALLOW_REGISTRATION=true

# Reverse proxies in front of the API (0 locally, 1 behind nginx in Docker or on Railway)
TRUST_PROXY=0

# --- Email confirmation (Fase 17) ---
# Public URL of the app: the confirmation links are ${APP_URL}/api/auth/verify-email?token=...
# Locally it defaults to this API (http://localhost:PORT). Required in production.
# Railway: https://<your-domain>.up.railway.app
# APP_URL=http://localhost:3000

# Resend API key (https://resend.com). SECRET: only in .env / Railway Variables, never in git.
# Without it the confirmation emails (with the link) are printed in the API console.
# RESEND_API_KEY=

# true (default): new accounts must confirm their email. false: no confirmation email and
# pending accounts can log in (useful while there is no verified sender domain in Resend).
# REQUIRE_EMAIL_VERIFICATION=true
# Sender. onboarding@resend.dev works without a domain but ONLY delivers to the email of
# your Resend account; verify your own domain in Resend to send to anyone.
# EMAIL_FROM=AuraWorkout <onboarding@resend.dev>
