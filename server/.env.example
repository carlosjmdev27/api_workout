# Runtime environment: development | production | test
NODE_ENV=development

# Port where the API listens
PORT=3000

# Exact frontend origin allowed by CORS (no trailing slash)
CORS_ORIGIN=http://localhost:5173

# SQLite database file (relative to the /server folder)
DATABASE_PATH=./database/gym.sqlite

# Secret that signs the session tokens (JWT). At least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs every user out.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# true: anyone can create an account. Set to false once your account exists.
ALLOW_REGISTRATION=true

# Reverse proxies in front of the API (0 locally, 1 behind nginx in Docker)
TRUST_PROXY=0